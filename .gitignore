__pycache__/
*.py[cod]
.venv/
venv/
.env
# `.env` alone was not enough: a `.env.bak.20260820` written while editing the real
# file was NOT ignored, and this repository is public — one `git add -A` would have
# published the Anthropic key, the SMTP password and the database DSN. Ignore every
# sibling and re-allow only the committed template.
.env.*
!.env.example
*.db
*.sqlite3
data/*.json
!data/.gitkeep
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.DS_Store
deploy/certs/

# Runtime logs — uvicorn/pipeline output, not source. Was tracked, so every
# local dashboard start showed up as a spurious diff.
*.log
